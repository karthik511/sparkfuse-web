---
import Base from '../../layouts/Base.astro';
import raw from '../../content/About.html?raw';
import '../../content/About.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`);
const title = "About SparkFuse \u2014 a consulting practice that builds, and runs what it builds";
const description = "Boutique AI and process consultancy in Bengaluru, founder-led, grown out of the AI products it operates.";
---
<Base title={title} description={description} section="about">
  <Fragment set:html={html} />
  
</Base>
