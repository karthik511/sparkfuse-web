---
import Base from '../../../layouts/Base.astro';
import raw from '../../../content/ProductRealEstateCRM.html?raw';
import '../../../content/ProductRealEstateCRM.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`);
const title = "Real-estate CRM with AI calling & WhatsApp \u2014 first response in 30 seconds | SparkFuse";
const description = "Portal leads, walk-ins and brokers in one inbox; every lead called by an AI agent in 30 seconds, qualified, booked and handed over. Designed for a Surat developer.";
---
<Base title={title} description={description} section="products">
  <Fragment set:html={html} />
  <script>import '../../../scripts/realestate.js';</script>
</Base>
