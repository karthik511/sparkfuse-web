---
import Base from '../../../layouts/Base.astro';
import Product from '../../../components/Product.astro';
import d from '../../../data/products/garment-erp.json';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/<[^>]+>/g, ''), acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })) };
---
<Base title="Garment & textile ERP \u2014 sourcing, sampling, T&A and inspections | SparkFuse" description="One system the whole floor works from: POs and tech packs read in, a T&A per order that re-plans itself, inspections on a phone, a live order book. Our deepest reference." section="products" schema={schema}>
  <Product d={d} />
  <script>import '../../../scripts/garment.js';</script>
</Base>
