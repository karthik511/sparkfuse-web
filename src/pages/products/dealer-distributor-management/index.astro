---
import Base from '../../../layouts/Base.astro';
import Product from '../../../components/Product.astro';
import d from '../../../data/products/dealer-distributor-management.json';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/<[^>]+>/g, ''), acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })) };
---
<Base title="Dealer & distributor order management for manufacturers | SparkFuse" description="Dealers order on their phones; one order book, one credit engine, collections that run themselves. Built for a uPVC manufacturer with 300+ dealers." section="products" schema={schema}>
  <Product d={d} />
  <script>import '../../../scripts/dealer.js';</script>
</Base>
