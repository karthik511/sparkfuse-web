---
import Base from '../../../layouts/Base.astro';
import raw from '../../../content/ProductDealer.html?raw';
import '../../../content/ProductDealer.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`);
const title = "Dealer & distributor order management for manufacturers | SparkFuse";
const description = "Dealers order on their phones; one order book, one credit engine, collections that run themselves. Built for a uPVC manufacturer with 300+ dealers.";
---
<Base title={title} description={description} section="products">
  <Fragment set:html={html} />
  <script>import '../../../scripts/dealer.js';</script>
</Base>
