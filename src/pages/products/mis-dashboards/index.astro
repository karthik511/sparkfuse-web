---
import Base from '../../../layouts/Base.astro';
import Product from '../../../components/Product.astro';
import d from '../../../data/products/mis-dashboards.json';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/<[^>]+>/g, ''), acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })) };
---
<Base title="MIS dashboards \u2014 reports that compile themselves, governance that triggers itself | SparkFuse" description="Data in from phones, POS and cameras; compiled nightly; a digest per role by 7:30; governance rules that ask a named person a question with a deadline." section="products" schema={schema}>
  <Product d={d} />
  <script>import '../../../scripts/mis.js';</script>
</Base>
