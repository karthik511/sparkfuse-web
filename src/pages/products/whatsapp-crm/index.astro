---
import Base from '../../../layouts/Base.astro';
import Product from '../../../components/Product.astro';
import d from '../../../data/products/whatsapp-crm.json';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/<[^>]+>/g, ''), acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })) };
---
<Base title="WhatsApp CRM \u2014 leads that don\u2019t die in chats | SparkFuse" description="A CRM inside your WhatsApp conversations: every lead a card, every promise a follow-up, ladders that run themselves. Fitted in 3\u20135 weeks." section="products" schema={schema}>
  <Product d={d} />
  <script>import '../../../scripts/whatsappcrm.js';</script>
</Base>
