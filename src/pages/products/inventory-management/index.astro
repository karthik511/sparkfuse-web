---
import Base from '../../../layouts/Base.astro';
import raw from '../../../content/ProductInventory.html?raw';
import '../../../content/ProductInventory.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`);
const title = "Inventory & warehouse management software \u2014 custom-fit | SparkFuse";
const description = "Stock you can trust and the money sitting still made visible. Lot traceability, reorder points, dead-stock with the rupees attached. Built for a Pune manufacturer.";
---
<Base title={title} description={description} section="products">
  <Fragment set:html={html} />
  <script>import '../../../scripts/inventory.js';</script>
</Base>
