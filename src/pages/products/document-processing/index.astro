---
import Base from '../../../layouts/Base.astro';
import Product from '../../../components/Product.astro';
import d from '../../../data/products/document-processing.json';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/<[^>]+>/g, ''), acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })) };
---
<Base title="Invoice & purchase-order processing \u2014 AI reads the document, your ERP gets the data | SparkFuse" description="Supplier invoices, buyer POs and delivery notes read as they land, matched against the PO and receipt, posted to Tally. Built for a garment exporter." section="products" schema={schema}>
  <Product d={d} />
  <script>import '../../../scripts/documents.js';</script>
</Base>
