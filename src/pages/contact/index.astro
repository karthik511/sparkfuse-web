---
import Base from '../../layouts/Base.astro';
import raw from '../../content/Contact.html?raw';
import '../../content/Contact.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`);
const title = "Contact \u2014 tell us the process that hurts | SparkFuse";
const description = "One human reply within a business day. WhatsApp, email, or the form.";
---
<Base title={title} description={description} section="contact">
  <Fragment set:html={html} />
  <script>import '../../scripts/contact.js';</script>
</Base>
