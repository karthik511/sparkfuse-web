---
import Base from '../../../layouts/Base.astro'; import { fixLegacy } from '../../../lib/legacyfix.js'; import UseCaseStrip from '../../../components/UseCaseStrip.astro'; import AppShell from '../../../components/demos/AppShell.astro'; import DemoSection from '../../../components/demos/DemoSection.astro';
import raw from '../../../content/IndustryGarment.html?raw';
import '../../../content/IndustryGarment.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`).replace(/src="\//g, `src="${base}/`); const fixed = fixLegacy(html, base);
const title = "AI & ERP for garment exporters and buying houses | SparkFuse";
const description = "From buyer PO to handover on one system. Our deepest reference: 200+ live orders, three buyers, twelve factories.";
---
<Base title={title} description={description} section="industries">
  <div class="legacy" data-legacy><Fragment set:html={fixed} /></div>
  <UseCaseStrip ind="garment-and-textile" />
  <DemoSection h="The ERP shell we run for a Tiruppur exporter." p="Today-first, approvals gated, the AI chasing in the middle. Click through; approve something." eb="Indicative screens"><AppShell /></DemoSection>
  
</Base>
