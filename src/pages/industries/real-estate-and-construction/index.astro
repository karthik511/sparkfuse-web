---
import Base from '../../../layouts/Base.astro'; import { fixLegacy } from '../../../lib/legacyfix.js'; import UseCaseStrip from '../../../components/UseCaseStrip.astro'; import VoiceOps from '../../../components/demos/VoiceOps.astro'; import DemoSection from '../../../components/demos/DemoSection.astro';
import raw from '../../../content/IndustryRealEstate.html?raw';
import '../../../content/IndustryRealEstate.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`).replace(/src="\//g, `src="${base}/`); const fixed = fixLegacy(html, base);
const title = "AI CRM & calling for real-estate developers | SparkFuse";
const description = "Every lead called in 30 seconds, follow-ups run by the system, site visits booked. Three phases, each a finished product.";
---
<Base title={title} description={description} section="industries">
  <div class="legacy" data-legacy><Fragment set:html={fixed} /></div>
  <UseCaseStrip ind="real-estate-and-construction" />
  <DemoSection h="Every enquiry called in 30 seconds. Here is what your team sees." p="Live calls, the log with transcripts, and the agent script in plain language." eb="Indicative screens"><VoiceOps start="live" /></DemoSection>
  
</Base>
