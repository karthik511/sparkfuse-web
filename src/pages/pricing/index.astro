---
import Base from '../../layouts/Base.astro';
import raw from '../../content/Pricing.html?raw';
import '../../content/Pricing.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`);
const title = "Pricing \u2014 what similar work has cost | SparkFuse";
const description = "Two ways to work: project-based or retainer. Move the sliders to see indicative ranges. Every engagement starts with a discovery session.";
---
<Base title={title} description={description} section="pricing">
  <Fragment set:html={html} />
  <script>import '../../scripts/pricing.js';</script>
</Base>
