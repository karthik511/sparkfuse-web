---
import Base from '../../../layouts/Base.astro';
import raw from '../../../content/ServiceAIConsulting.html?raw';
import '../../../content/ServiceAIConsulting.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = raw.replace(/href="\//g, `href="${base}/`).replace(/src="\//g, `src="${base}/`);
const title = "AI consulting services & custom AI development, Bengaluru | SparkFuse";
const description = "Strategy, build, rollout and monitoring \u2014 one person answerable for all four. Solutions Architect-led. Voice, documents, vision, ERP/CRM, custom models. Led by two founders.";
---
<Base title={title} description={description} section="about">
  <div class="legacy" data-legacy><Fragment set:html={html} /></div>
  
</Base>
