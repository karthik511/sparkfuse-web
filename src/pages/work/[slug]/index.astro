---
import Base from '../../../layouts/Base.astro'; import CtaBand from '../../../components/CtaBand.astro'; import '../../../content/_shared.css';
import { cases } from '../../../data/site.js';
const detail = {
  'vehicle-inspection': { h: 'Pricing a used car without the guesswork.', ctx: 'Evaluators were pricing vehicles on judgement and memory. Two people could inspect the same car and land on very different numbers — and the business carried that spread as margin risk.', before: ['Inspection quality varied by evaluator', 'Resale price set by gut feel and local memory', 'No link between condition and the number quoted'], after: ['207 checkpoints, same standard every time', 'Live open-market resale value derived from condition', 'Checked against internal inventory, then a price recommended'], ai: 'Condition data from the inspection is scored, matched against live market pricing and the company’s own stock position, then converted into a recommended sale price — so the decision is defensible, not personal.', mods: ['Vision AI', 'Decision systems', 'Mobile inspection app'], rel: ['/solutions/vision-ai/', '/products/manufacturing-erp/'] },
  'voice-platform': { h: 'Conversations that finally get measured.', ctx: 'Most businesses run their revenue through phone calls and then measure none of it. Calls happen, notes don’t, and follow-ups depend on whoever remembers. This is our own product — built, operated and paid for by us.', before: ['Call quality invisible — nobody reviews recordings', 'Follow-ups dropped when volume rose', 'No line between conversations and pipeline'], after: ['AI agents place and answer calls at volume, 24/7, in Hindi and English', 'Sentiment analysis and live tracking on every call', 'Every conversation becomes data the business can manage against'], ai: 'Voice agents hold the conversation; the platform turns each call into a record — transcript, entities, temperature, next action — and tracks connection rate, outcomes and minute economics per campaign. Running it at 400+ businesses is why our strategy accounts for the day the agent gets something wrong.', mods: ['Voice AI', 'Call analytics', 'WhatsApp inbox'], rel: ['/products/ai-calling-agent/', '/lab/voice-agent-cost/'] },
  'service-centre-vision': { h: 'Seeing the revenue advisors miss.', ctx: 'Service centres lose money on what nobody notices. An advisor has minutes with a vehicle and no reliable way to spot every serviceable issue — so genuine work goes unquoted and invoice value stays flat. Our own product.', before: ['Upsell depended on the individual advisor’s eye', 'Visible issues missed under time pressure', 'No record of what was spotted vs quoted'], after: ['Vision models detect visible issues in real time at the bay', 'Issues surfaced as service opportunities while the customer is still there', '12,000+ downloads, 7+ service organisations'], ai: 'Vision models on the advisor’s phone detect visible issues and surface them as service opportunities, so advisors quote accurately and invoice value rises without pressure selling.', mods: ['Vision AI', 'Mobile app', 'Analytics'], rel: ['/solutions/vision-ai/'] },
  'companion-model': { h: 'A model we fine-tuned ourselves.', ctx: 'A consumer AI companion for conversation and emotional support. It matters here for one reason: it is proof we work at the model layer, not just the API layer — fine-tuning behaviour, tone and safety rather than wrapping someone else’s chatbot.', before: ['Off-the-shelf models drift in tone and forget', 'Guardrails around sensitive conversation are the part most builds skip'], after: ['Fine-tuned conversational model, tuned for warmth and memory', 'Multiple companion personas with consistent character', 'Guardrails around sensitive conversation, built in', '3,000 monthly active users within days of launch'], ai: 'When a use case genuinely needs a model that behaves differently — your tone, your domain, your rules — that’s a fine-tuning problem, not a prompt. We can tell you which one you actually have.', mods: ['Custom AI models', 'Consumer app'], rel: ['/solutions/custom-ai-models/', '/services/app-development/'] },
  'creator-platform': { h: 'A creator platform, end to end.', ctx: 'A creator platform built for a client and shipped to the Play Store: short video, live streaming, rewards, creator earnings and phone-OTP onboarding. Enterprise systems and consumer apps fail in completely different ways — this one proves we’ve shipped both.', before: ['A concept and a deck', 'No infrastructure for video at consumer volume'], after: ['Native mobile app, live on the Play Store', 'Live streaming, feed ranking and creator rewards', 'OTP and Google authentication, built for Indian users', '27,000 downloads · 6,700 MAU · ~50% month-on-month growth'], ai: 'Feed ranking and reward logic tuned on real usage; the growth loop designed into the product, not bolted on.', mods: ['Consumer app', 'Video infrastructure', 'Auth & payments'], rel: ['/services/app-development/'] },
};
export function getStaticPaths() { return cases.filter(c => !c.live).map(c => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props; const d = detail[c.slug]; const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${c.name} — case study | SparkFuse`} description={d.ctx.slice(0, 155)} section="work">
  <div class="hero"><div class="mono">Work › {c.tag}</div><h1 class="h1">{d.h}</h1><p class="p" style="font-size: 16px;">{d.ctx}</p></div>
  <div class="sec"><div class="grid2"><div style="display: flex; flex-direction: column; gap: 8px;"><div class="mono">Before</div>{d.before.map(x => <div class="li g" style="padding: 8px 0; border-bottom: 1px solid var(--line);">{x}</div>)}</div><div style="display: flex; flex-direction: column; gap: 8px;"><div class="eb">After</div>{d.after.map(x => <div class="li" style="padding: 8px 0; border-bottom: 1px solid var(--line);">{x}</div>)}</div></div></div>
  <div class="dark" style="margin: 40px var(--gx) 0; padding: 36px 48px; display: flex; flex-direction: column; gap: 10px;"><div class="eb">The AI layer</div><p class="p" style="font-size: 16px; color: #EFEEE9;">{d.ai}</p></div>
  <div class="sec"><div class="grid3">{c.nums.map(([n, l]) => <div class="card"><div class="num">{n}</div><div class="mono">{l}</div></div>)}</div></div>
  <div class="sec"><div class="card q" style="flex-direction: row; gap: 16px; align-items: center; flex-wrap: wrap;"><div class="mono">Modules</div>{d.mods.map(m => <span class="chip">{m}</span>)}<div class="mono" style="margin-left: auto;">Related</div>{d.rel.map(r => <a href={`${base}${r}`} style="font-weight: 600; font-size: 13px;">{r.split('/').filter(Boolean).pop().replace(/-/g, ' ')} →</a>)}</div></div>
  <CtaBand h="Your process is the eighth case study." />
</Base>
