---
import Base from '../../../layouts/Base.astro'; import CtaBand from '../../../components/CtaBand.astro'; import LabFig from '../../../components/LabFig.astro'; import '../../../content/_shared.css';
import { labNotes, labBody } from '../../../data/lab.js';
const rel = { Voice: ['/products/ai-calling-agent/', 'AI calling agent', '/solutions/voice-ai/', 'Voice AI'], Models: ['/solutions/custom-ai-models/', 'Custom AI models', '/solutions/voice-ai/', 'Voice AI'], Documents: ['/products/document-processing/', 'Invoice & PO processing', '/solutions/document-ai/', 'Document AI'], Reliability: ['/solutions/erp-crm-systems/', 'ERP / CRM systems', '/services/ai-consulting/', 'How we work'], Process: ['/products/ai-workflow-automation/', 'AI workflow automation', '/solutions/whatsapp-and-process-automation/', 'WhatsApp & process automation'], Rollout: ['/services/ai-consulting/', 'AI consulting', '/about/', 'About the practice'], Vision: ['/solutions/vision-ai/', 'Vision AI', '/work/service-centre-vision/', 'Service-centre vision case'], ERP: ['/products/garment-erp/', 'Garment & textile ERP', '/work/garment-sourcing-erp/', 'Garment sourcing case'] };
export function getStaticPaths() { return labNotes.map(n => ({ params: { slug: n.slug }, props: { n } })); }
const { n } = Astro.props; const base = import.meta.env.BASE_URL.replace(/\/$/, ''); const body = labBody[n.slug]; const r = rel[n.tag] || rel.Rollout;
const more = labNotes.filter(x => x.slug !== n.slug).sort((a, b) => (b.tag === n.tag) - (a.tag === n.tag) || b.date.localeCompare(a.date)).slice(0, 3);
const d = s => new Date(s).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: n.title, datePublished: n.date, author: { '@type': 'Organization', name: 'SparkFuse Business Solutions LLP' } };
---
<Base title={`${n.title} | SparkFuse Lab`} description={n.tldr.slice(0, 155)} section="lab" schema={schema}>
  <section class="sec" style="padding-bottom: 0;">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 22px;" data-io><a class="mono" href={`${base}/lab/`} style="color: var(--muted);">Lab</a><span class="mono">›</span><span class="chip">{n.tag}</span><span class="mono">{d(n.date)}</span></div>
      <h1 class="h1" data-io style="font-size: clamp(30px, 4vw, 48px); max-width: 900px;">{n.title}</h1>
      <div class="split wide" style="align-items: center; margin-top: 28px;" data-io><div class="tldr" style="margin: 0;">{n.tldr}</div><LabFig fig={n.fig} size="hero" /></div>
    </div>
  </section>
  <section class="sec">
    <div class="container"><div class="prose" set:html={body} /></div>
  </section>
  <section class="sec" style="padding-top: 0;">
    <div class="container">
      <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 28px;" data-io><span class="mono">Related</span><a class="chip" href={`${base}${r[0]}`}>{r[1]} →</a><a class="chip" href={`${base}${r[2]}`}>{r[3]} →</a></div>
      <div class="sec-head" data-io style="margin-bottom: 20px;"><div class="eb">More notes</div></div>
      <div class="grid3">{more.map(m => <a class="card hover" href={`${base}/lab/${m.slug}/`} data-io><div class="mono"><span style="color: var(--red);">{m.tag}</span> · {d(m.date)}</div><div class="t">{m.title}</div><div class="d">{m.tldr}</div></a>)}</div>
      <div style="height: 48px;"></div>
      <CtaBand h="Have a number you can’t explain?" p="Send us the process behind it. Most of these notes started as a client’s unexplained number." />
    </div>
  </section>
</Base>
