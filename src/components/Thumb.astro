---
const { i = 0 } = Astro.props;
const pats = [[['r','40%'],['','90%'],['','70%'],['k','55%']],[['k','60%'],['','90%'],['r','30%'],['','80%']],[['','85%'],['','85%'],['r','45%'],['','85%']],[['k','35%'],['','95%'],['','95%'],['r','60%']]];
---
<div class="thumb">{pats[i % 4].map(([c, w]) => <div class={`bar ${c}`} style={`width: ${w};`}></div>)}</div>
