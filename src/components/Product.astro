---
import CtaBand from './CtaBand.astro';
import { products, hubs } from '../data/site.js';
const { d } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p) => `${base}${p}`;
const meta = products.find(p => p.slug === d.slug);
const hub = hubs.find(h => h.slug === meta?.hub);
const mock = (d.mock || '').replace(/href="\//g, `href="${base}/`);
const fix = (s) => (s || '').replace(/href="\//g, `href="${base}/`);
const icons = ['M4 6h16M4 12h16M4 18h10', 'M12 3l9 4.5v9L12 21l-9-4.5v-9z', 'M3 12h4l3-8 4 16 3-8h4', 'M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z', 'M4 4h16v16H4zM4 10h16M10 4v16', 'M20 6L9 17l-5-5', 'M22 2L11 13M22 2l-7 20-4-9-9-4z', 'M3 3v18h18M7 14l4-4 4 4 5-6'];
const fitted = (d.fitted || []).filter(x => /^Fitted/.test(x)); const ready = (d.fitted || []).filter(x => /^Ready/.test(x));
---
<!-- HERO -->
<section class="sec" style="padding-bottom: clamp(40px, 5vw, 64px);">
  <div class="container">
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 26px;">
      <a class="mono" href={u('/products/')} style="color: var(--muted);">Products</a><span class="mono">›</span>
      {hub && <a class="chip" href={u(`/solutions/${hub.slug}/`)}>{hub.name}</a>}
      {(d.chips || []).slice(1).map(c => <span class="chip">{c}</span>)}
    </div>
    <div class="phero">
      <div style="display: flex; flex-direction: column; gap: 18px;">
        <h1 class="h1" style="font-size: clamp(32px, 4.4vw, 58px);">{d.h1} <span class="g" set:html={d.h1g} /></h1>
      </div>
      <div style="display: flex; flex-direction: column; gap: 18px;">
        <p class="lede" set:html={d.lede} />
        <p class="p" style="font-size: 15px;" set:html={d.semi} />
        <div style="display: flex; gap: 12px; flex-wrap: wrap;"><a class="btn red" href={u('/contact/')}>See it on a call <span class="arr">→</span></a><a class="btn2" href={u('/pricing/')}>How pricing works</a></div>
      </div>
    </div>
    <div class="glow" data-io>
      <div class="frame mock">
        <div class="chrome"><i></i><i></i><i></i><div class="url">app.sparkfuse.in/{d.slug}</div><div class="live">Interactive mock</div></div>
        <Fragment set:html={mock} />
      </div>
      <div class="mono" style="color: var(--red); margin-top: 14px;">{d.tryit}</div>
    </div>
  </div>
</section>

<!-- REFERENCE BUILD -->
{d.ref_h && <section class="container" data-io>
  <div class="dark band" style="padding: clamp(32px, 4vw, 56px);">
    <div class="split" style="align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 14px; position: relative;">
        <div class="eb">{d.ref_eb}</div>
        <h2 class="h2" style="color: #fff;">{d.ref_h} <span style="color: var(--dark-muted);" set:html={d.ref_hg} /></h2>
        <p class="p" style="font-size: 15.5px;" set:html={d.ref_p} />
        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 6px;">{(d.ref_li || []).map(x => <div class="li" set:html={x} />)}</div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; position: relative;">
        {(d.ref_nums || []).map(([n, l]) => <div style="background: var(--dark2); border: 1px solid #2A2A27; border-radius: 14px; padding: 22px 18px; display: flex; flex-direction: column; gap: 8px;"><div class={`num${/^[\d₹$]/.test(n) ? '' : ' word'}`} style="color: #fff;" data-count={n}>{n}</div><div class="mono" style="color: var(--dark-muted);">{l}</div></div>)}
      </div>
    </div>
  </div>
</section>}

<!-- USE CASES / MODULE GRID (page-specific) -->
{(d.uses?.length > 0 || d.mods?.length > 0 || d.usecard?.length > 0) && <section class="sec">
  <div class="container">
    <div class="sec-head" data-io><div class="eb">{d.mods?.length ? 'Modules' : 'What businesses use it for'}</div><h2 class="h2">{d.mods?.length ? 'What’s in it. Each one usable on its own.' : 'The flows we fit most often.'}</h2></div>
    <div class="grid4">
      {(d.mods?.length ? d.mods : (d.uses?.length ? d.uses : d.usecard)).map(([k, t, p], i) => <div class="card hover" data-io><div class="mono" style="color: var(--red);">{k}</div><div class="t">{t}</div><div class="d" set:html={p} /></div>)}
    </div>
  </div>
</section>}

<!-- MODULES + FITTED + AI -->
<section class="sec" style="background: var(--surface); border-block: 1px solid var(--line);">
  <div class="container">
    <div class="grid3" style="gap: clamp(28px, 4vw, 56px);">
      <div data-io style="display: flex; flex-direction: column; gap: 16px;">
        <div class="eb">{d.modules_title}</div>
        <h3 class="h3">Built from modules we already run.</h3>
        <div style="display: flex; flex-direction: column; gap: 10px;">{(d.modules || []).map(x => <div class="li" set:html={x} />)}</div>
      </div>
      <div data-io style="display: flex; flex-direction: column; gap: 16px;">
        <div class="eb">Ready vs fitted</div>
        <h3 class="h3">About 70% ready. 30% fitted to you.</h3>
        <div class="ratio"><div></div><div></div></div>
        <div style="display: flex; justify-content: space-between;"><span class="mono">≈70% ready modules</span><span class="mono" style="color: var(--red);">≈30% fitted</span></div>
        <div style="display: flex; flex-direction: column; gap: 10px;">{fitted.map(x => <div class="li" set:html={x} />)}{ready.map(x => <div class="li g" set:html={x} />)}</div>
      </div>
      <div data-io style="display: flex; flex-direction: column; gap: 16px;">
        <div class="eb">What the AI actually does</div>
        <h3 class="h3">It sits at the centre of the workflow.</h3>
        <div style="display: flex; flex-direction: column; gap: 10px;">{(d.ai || []).map(x => <div class="li" set:html={x} />)}</div>
        <p class="small">Not a chat box bolted on in the corner.</p>
      </div>
    </div>
  </div>
</section>

<!-- EXTRA SCREENS + ENGAGEMENT -->
<section class="sec">
  <div class="container split wide" style="align-items: start;">
    <div data-io style="display: flex; flex-direction: column; gap: 18px;">
      <div class="eb">How an engagement runs</div>
      <h2 class="h2">A defined project — a start, an end, and a number attached.</h2>
      <div style="display: flex; flex-direction: column; border-top: 1px solid var(--line); margin-top: 6px;">
        {(d.engagement || []).map(([w, t]) => <div style="display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 15px;"><span class="mono" style="padding-top: 3px;">{w}</span><span>{t}</span></div>)}
      </div>
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 6px;"><div><div class="mono">Typical</div><div style="font-weight: 700; font-size: 24px; letter-spacing: -.02em;">{d.price}</div>{d.price_note && <div class="small">{d.price_note}</div>}</div><a class="btn2" href={u('/pricing/')}>Pricing <span class="arr">→</span></a></div>
    </div>
    <div data-io style="display: flex; flex-direction: column; gap: 16px;">
      {(d.extra || []).map(x => <div class="frame mock" style="padding: 18px 20px;"><Fragment set:html={fix(x).replace(/class="card q"/, 'class="x"')} /></div>)}
      {(!d.extra || d.extra.length === 0) && <div class="card flat" style="gap: 12px;"><div class="eb">What you get</div><div class="li">A process map before a line of code</div><div class="li">A working system on your real data</div><div class="li">A team running it, not a PDF manual</div><div class="li">Proof, in the number we agreed</div></div>}
    </div>
  </div>
</section>

<slot name="demo" />

<!-- COMPARISON -->
{d.cmp && <section class="sec" style="padding-top: 0;">
  <div class="container">
    <div class="sec-head" data-io><div class="eb">Honest comparison</div><h2 class="h2">Where this sits against the alternatives.</h2></div>
    <div class="tbl" data-io><table class="cmp"><thead><tr>{d.cmp_head.map(h => <th>{h || ''}</th>)}</tr></thead><tbody>{d.cmp.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody></table></div>
    {d.cmp_note && <p class="small" style="margin-top: 12px;" set:html={d.cmp_note} />}
  </div>
</section>}

<!-- FAQ -->
<section class="sec" style="background: var(--surface); border-top: 1px solid var(--line);">
  <div class="container split" style="align-items: start;">
    <div data-io style="display: flex; flex-direction: column; gap: 14px;"><div class="eb">FAQ</div><h2 class="h2">{d.faq_h}</h2><p class="p">The questions that come up on the first call — answered the way we'd answer them there.</p></div>
    <div class="faq" data-io>{(d.faq || []).map(([q, a], i) => <details open={i === 0}><summary set:html={q} /><div class="a" set:html={a} /></details>)}</div>
  </div>
</section>

<!-- RELATED + CTA -->
<section class="sec" style="padding-bottom: 0;">
  <div class="container">
    <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 40px;" data-io><span class="mono">Related</span>{(d.related || []).map(([t, h]) => <a class="chip" href={u(h)}>{t}</a>)}</div>
    <CtaBand h={d.cta_h} p={d.cta_p} label={d.cta_l || 'Talk to us'} />
  </div>
</section>
