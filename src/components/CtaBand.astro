---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { h = 'Tell us the process that hurts.', p = 'One conversation, then a scoped proposal with a fixed number. Nothing locked in.', label = 'Talk to us' } = Astro.props;
---
<div class="dark band" data-io style="padding: clamp(32px, 4vw, 56px); display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;">
  <div style="display: flex; flex-direction: column; gap: 8px; position: relative; max-width: 620px;"><h2 class="h2" style="color: #fff;">{h}</h2><p class="p" style="font-size: 15.5px;" set:html={p} /></div>
  <a class="btn red" href={`${base}/contact/`} style="position: relative;">{label} <span class="arr">→</span></a>
</div>
