---
// Small, honest product-UI compositions used as product thumbnails (no stock art, no bar-placeholders)
const { kind = 'chat' } = Astro.props;
---
<div class={`mini mini-${kind}`} aria-hidden="true">
  {kind === 'chat' && <><div class="mb l">Delivery moved to 12 Oct</div><div class="mb r">Plan re-scheduled · 3 stages</div><div class="mrow"><span class="mt">Task</span> Confirm ex-factory · Meena</div><div class="mrow"><span class="mt r">Draft</span> Chase to factory ready</div></>}
  {kind === 'crm' && <><div class="mcard"><b>Sneha Desai</b><span>2 BHK · ₹80 L · warm</span></div><div class="mlad"><i></i>Sat 20:00 · visit reminder</div><div class="mlad"><i></i>Mon 11:00 · no-show → call</div></>}
  {kind === 'bot' && <><div class="mb l">order kab aayega?</div><div class="mb r">Dispatched 14:10 · LR 44821 · Thu 18 Sep</div><div class="mb l">rate kam karo</div><div class="mb r hand">→ Vikram, 15 min</div></>}
  {kind === 'kpi' && <><div class="mk"><b>$2.18M</b><span>order book</span></div><div class="mk"><b>3</b><span>will miss ETD</span></div><div class="mk"><b>₹3 Cr</b><span>idle stock</span></div><div class="mk"><b>8d</b><span>OTIF warning</span></div></>}
  {kind === 'bins' && <div class="mbins">{[80,45,12,70,90,100,100,35,60,8,55,75].map(w => <i class={w === 100 ? 'd' : w < 20 ? 'l' : ''} style={`--w:${w}%`}></i>)}</div>}
  {kind === 'doc' && <><div class="mdoc"><span>Invoice DP/26-27/1183</span><em>₹4,38,960</em></div><div class="mfld"><span>PO match</span><b>4471 ✓</b></div><div class="mfld"><span>Rate</span><b class="bad">₹186 vs ₹181.50</b></div><div class="mfld"><span>Qty</span><b>1,960 kg</b></div></>}
  {kind === 'flow' && <div class="mflow"><i class="on">Detect</i><s></s><i class="on">Chase</i><s></s><i class="on">Escalate</i><s></s><i>Ask human</i></div>}
  {kind === 'call' && <><div class="mwave">{[8,18,30,22,40,26,12,34,20,38,16,28,42,24,10,32,18,36,22,14].map(h => <i style={`height:${h}px`}></i>)}</div><div class="mfld"><span>Temperature</span><b class="hot">Hot · visit booked</b></div><div class="mfld"><span>Next</span><b>Sun 21 Sep 3:00 · Kiran</b></div></>}
  {kind === 'order' && <><div class="mfld"><span>DO-26-1187</span><b>₹1,86,400</b></div><div class="mlad"><i class="ok"></i>Credit OK · ₹4.2 L</div><div class="mlad"><i class="ok"></i>Allocated · Agra + Kanpur</div><div class="mlad"><i class="ok"></i>WhatsApp sent · ETA 18 Sep</div></>}
  {kind === 'pipe' && <div class="mpipe"><div><span>New</span><i class="new"></i><i></i></div><div><span>Qualified</span><i></i><i></i><i></i></div><div><span>Visit</span><i></i><i></i></div><div><span>Token</span><i></i></div></div>}
  {kind === 'gantt' && <div class="mgantt">{[[4,10,'done'],[18,12,''],[32,6,''],[38,22,''],[62,5,''],[71,3,'late']].map(([l, w, c]) => <div><i class={c} style={`left:${l}%;width:${w}%`}></i></div>)}<b style="left: 82%"></b></div>}
  {kind === 'mis' && <><div class="mout"><span>Cantonment</span><b class="ok">92</b></div><div class="mout bad"><span>Srirangam</span><b>61</b></div><div class="mout"><span>Banquets</span><b class="ok">94</b></div><div class="mrow"><span class="mt r">Ask</span> Ramesh · wastage 9.4% · by 12:00</div></>}
</div>
<style is:global>
  .mini { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 7px; min-height: 148px; font-size: 11.5px; color: var(--ink2); overflow: hidden; position: relative; }
  .mini::after { content: ""; position: absolute; inset: auto 0 0 0; height: 30px; background: linear-gradient(transparent, #fff); }
  .mini .mb { max-width: 86%; padding: 6px 9px; border-radius: 8px; background: var(--bg2); line-height: 1.35; } .mini .mb.r { align-self: flex-end; background: #DCF8C6; } .mini .mb.hand { background: var(--red-soft); color: var(--red-ink); font-weight: 600; }
  .mini .mrow { display: flex; gap: 8px; align-items: center; padding: 6px 8px; border: 1px solid var(--line); border-radius: 8px; } .mini .mt { font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; padding: 2px 6px; border-radius: 999px; background: var(--ok-soft); color: var(--ok); } .mini .mt.r { background: var(--red-soft); color: var(--red-ink); }
  .mini .mcard { display: flex; flex-direction: column; padding: 8px 10px; border: 1.5px solid var(--red); border-radius: 8px; background: #FFFBFA; } .mini .mcard b { font-size: 12.5px; color: var(--ink); } .mini .mcard span { font-size: 11px; }
  .mini .mlad { display: flex; align-items: center; gap: 8px; } .mini .mlad i { width: 8px; height: 8px; border-radius: 50%; background: var(--line2); flex: none; } .mini .mlad i.ok { background: var(--ok); }
  .mini-kpi { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; } .mini .mk { border: 1px solid var(--line); border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 2px; } .mini .mk b { font-size: 18px; letter-spacing: -.02em; color: var(--ink); } .mini .mk span { font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  .mini .mbins { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; } .mini .mbins i { height: 40px; border: 1px solid var(--line); border-radius: 5px; position: relative; background: #fff; } .mini .mbins i::after { content: ""; position: absolute; left: 5px; right: 5px; bottom: 6px; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--ink) var(--w), var(--bg2) var(--w)); } .mini .mbins i.d { background: var(--red-soft); } .mini .mbins i.d::after { background: var(--red); } .mini .mbins i.l { background: var(--warn-soft); }
  .mini .mdoc { display: flex; justify-content: space-between; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; font-family: var(--mono); font-size: 10px; } .mini .mdoc em { font-style: normal; background: var(--ok-soft); color: var(--ok); padding: 0 4px; border-radius: 3px; }
  .mini .mfld { display: flex; justify-content: space-between; gap: 8px; padding: 5px 0; border-bottom: 1px solid var(--line); } .mini .mfld span { font-family: var(--mono); font-size: 9.5px; letter-spacing: .06em; text-transform: uppercase; } .mini .mfld b { color: var(--ink); font-weight: 600; } .mini .mfld b.bad { color: var(--red-ink); } .mini .mfld b.hot { color: var(--red-ink); }
  .mini .mflow { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; margin-top: 18px; } .mini .mflow i { font-style: normal; padding: 8px 10px; border: 1.5px solid var(--line2); border-radius: 8px; font-weight: 600; color: var(--ink); font-size: 11px; } .mini .mflow i.on { border-color: var(--red); background: #FFFBFA; } .mini .mflow s { width: 12px; height: 2px; background: var(--red); display: block; }
  .mini .mwave { display: flex; align-items: center; gap: 3px; height: 46px; } .mini .mwave i { width: 4px; border-radius: 2px; background: var(--red); opacity: .85; }
  .mini .mpipe { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; } .mini .mpipe > div { display: flex; flex-direction: column; gap: 4px; background: var(--bg); border-radius: 6px; padding: 6px; } .mini .mpipe span { font-family: var(--mono); font-size: 8.5px; letter-spacing: .08em; text-transform: uppercase; } .mini .mpipe i { height: 18px; border-radius: 4px; background: #fff; border: 1px solid var(--line); } .mini .mpipe i.new { border: 1.5px solid var(--red); }
  .mini .mgantt { position: relative; display: flex; flex-direction: column; gap: 6px; padding-top: 4px; } .mini .mgantt > div { position: relative; height: 12px; background: var(--bg); border-radius: 3px; } .mini .mgantt i { position: absolute; top: 2px; height: 8px; border-radius: 2px; background: var(--ink); } .mini .mgantt i.done { background: var(--ok); } .mini .mgantt i.late { background: var(--red); } .mini .mgantt b { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--red); }
  .mini .mout { display: flex; justify-content: space-between; padding: 6px 9px; border: 1px solid var(--line); border-radius: 7px; } .mini .mout b { font-family: var(--mono); color: var(--red-ink); } .mini .mout b.ok { color: var(--ok); } .mini .mout.bad { border-color: var(--red); background: #FFFBFA; }
</style>
