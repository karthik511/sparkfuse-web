---
import '../styles/global.css';
import { products, hubs, industries } from '../data/site.js';
const { title, description, section = '', noindex = true, schema = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p) => `${base}${p}`;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'SparkFuse Business Solutions LLP', url: 'https://sparkfuse.in', address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' } };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#F6F5F0" />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
<div class="page">
  <header class="nav" data-nav>
    <div class="container in">
      <a class="brand" href={u('/')} aria-label="SparkFuse home"><span class="mark"></span><span class="word">SparkFuse</span></a>
      <nav class="links" aria-label="Main">
        <div class="m"><button type="button" class={section === 'products' ? 'on' : ''} aria-haspopup="true">Products <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></button>
          <div class="menu" role="menu">
            {products.map(p => <a href={u(`/products/${p.slug}/`)} role="menuitem"><b>{p.name}</b><span>{p.line}</span></a>)}
            <a class="all" href={u('/products/')}>All products →</a>
          </div>
        </div>
        <div class="m"><button type="button" class={section === 'solutions' ? 'on' : ''} aria-haspopup="true">Solutions <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></button>
          <div class="menu" role="menu" style="min-width: 520px;">
            {hubs.map(h => <a href={u(`/solutions/${h.slug}/`)} role="menuitem"><b>{h.name}</b><span>{h.line}</span></a>)}
          </div>
        </div>
        <div class="m"><button type="button" class={section === 'industries' ? 'on' : ''} aria-haspopup="true">Industries <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></button>
          <div class="menu" role="menu" style="min-width: 480px;">
            {industries.map(i => <a href={u(`/industries/${i.slug}/`)} role="menuitem"><b>{i.name}</b><span>{i.line}</span></a>)}
          </div>
        </div>
        <a href={u('/work/')} class={section === 'work' ? 'on' : ''}>Work</a>
        <a href={u('/lab/')} class={section === 'lab' ? 'on' : ''}>Lab</a>
        <a href={u('/pricing/')} class={section === 'pricing' ? 'on' : ''}>Pricing</a>
        <a href={u('/about/')} class={section === 'about' ? 'on' : ''}>About</a>
      </nav>
      <a class="cta" href={u('/contact/')}>Talk to us</a>
      <button class="burger" aria-label="Menu" aria-expanded="false" data-burger><span></span></button>
    </div>
  </header>
  <nav class="mnav" data-mnav aria-label="Mobile">
    <a href={u('/products/')}>Products</a><a href={u('/solutions/')}>Solutions</a><a href={u('/industries/')}>Industries</a><a href={u('/work/')}>Work</a><a href={u('/lab/')}>Lab</a><a href={u('/pricing/')}>Pricing</a><a href={u('/about/')}>About</a>
    <a href={u('/contact/')} style="color: var(--red); font-weight: 600;">Talk to us →</a>
  </nav>
  <main>
    <slot />
  </main>
  <footer class="foot">
    <div class="container">
      <div class="cols">
        <div class="col"><div style="font-weight: 700; font-size: 20px; color: #fff; letter-spacing: -.02em;">SparkFuse</div><div>SparkFuse Business Solutions LLP · Bengaluru, India</div><div class="k" style="color: #76756E; margin-top: 8px;">= Strategy + Build + Rollout + Monitoring</div></div>
        <div class="col"><div class="k">Products</div>{products.slice(0, 6).map(p => <a href={u(`/products/${p.slug}/`)}>{p.name}</a>)}</div>
        <div class="col"><div class="k">More products</div>{products.slice(6).map(p => <a href={u(`/products/${p.slug}/`)}>{p.name}</a>)}</div>
        <div class="col"><div class="k">Industries</div>{industries.map(i => <a href={u(`/industries/${i.slug}/`)}>{i.name}</a>)}<div class="k" style="margin-top: 12px;">Solutions</div>{hubs.slice(0, 4).map(h => <a href={u(`/solutions/${h.slug}/`)}>{h.name}</a>)}</div>
        <div class="col"><div class="k">Firm</div><a href={u('/services/ai-consulting/')}>AI consulting</a><a href={u('/services/app-development/')}>App development</a><a href={u('/work/')}>Work</a><a href={u('/lab/')}>Lab</a><a href={u('/pricing/')}>Pricing</a><a href={u('/about/')}>About</a><a href={u('/contact/')}>Contact</a></div>
      </div>
      <div class="legal"><span>© 2026 SparkFuse Business Solutions LLP</span><span>Every screen on this site is a mockup with fictional data. Client engagements are anonymised.</span></div>
    </div>
  </footer>
</div>
<script>
  const nav = document.querySelector('[data-nav]'); const b = document.querySelector('[data-burger]'); const m = document.querySelector('[data-mnav]');
  b?.addEventListener('click', () => { const o = m.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8); onScroll(); addEventListener('scroll', onScroll, { passive: true });
  // scroll reveals
  const ios = [...document.querySelectorAll('[data-io]')]; ios.forEach((el, i) => { el.style.transitionDelay = (Math.min(i % 6, 5) * 70) + 'ms'; });
  const show = el => el.classList.add('in');
  const check = () => { const vh = innerHeight; ios.forEach(el => { if (el.classList.contains('in')) return; const r = el.getBoundingClientRect(); if (r.top < vh * .95 && r.bottom > 0) show(el); }); };
  if ('IntersectionObserver' in window) { const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } }), { rootMargin: '0px 0px -5% 0px', threshold: .05 }); ios.forEach(el => io.observe(el)); }
  check(); addEventListener('scroll', check, { passive: true }); addEventListener('resize', check); setTimeout(check, 300); setTimeout(check, 1500);
  // count-ups
  const co = new IntersectionObserver(es => es.forEach(e => { if (!e.isIntersecting) return; co.unobserve(e.target); const el = e.target; const raw = el.dataset.count; const num = parseFloat(raw.replace(/[^\d.]/g, '')); if (isNaN(num)) return; const pre = raw.match(/^[^\d]*/)[0], suf = raw.match(/[^\d.]*$/)[0]; const dec = (raw.split('.')[1] || '').replace(/[^\d]/g, '').length; const t0 = performance.now(), dur = 1100; const step = t => { const k = Math.min(1, (t - t0) / dur); const v = num * (1 - Math.pow(1 - k, 3)); el.textContent = pre + v.toLocaleString('en-IN', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suf; if (k < 1) requestAnimationFrame(step); }; requestAnimationFrame(step); }), { threshold: .5 });
  document.querySelectorAll('[data-count]').forEach(el => co.observe(el));
</script>
</body>
</html>
